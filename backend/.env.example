# Copy this file to .env and fill in real values before running the app.
# Never commit the actual .env file - it's already gitignored.

# Set to "production" on a real deployment. When production, the app refuses to start
# if SECRET_KEY is left unset (see auth.py) instead of silently using an insecure default.
ENVIRONMENT=development

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production - the app will not start without it.
SECRET_KEY=your-secret-key-change-this

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Defaults to "*" (allow any origin) if unset - fine for local dev, must be restricted
# to real origin(s) in production.
CORS_ORIGINS=*

# Set to "false" to skip inserting the demo testuser/leads/deals/etc. on first run
# against a genuinely empty database. Has no effect once the database already has data -
# init_db() never re-seeds or wipes an existing database on later restarts either way.
SEED_DEMO_DATA=true

# Only used by database.py / main_postgresql.py (the separate, currently-incomplete
# Postgres implementation - the app you're running uses SQLite via database_sqlite.py
# and doesn't read these).
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=arthainvest_crm
DB_PORT=5432

# Twilio click-to-call (Integrations tab). All three required - get them from
# https://console.twilio.com. TWILIO_FROM_NUMBER must be a number you own on Twilio.
# Without these set, POST /api/calls/dial returns configured=false and the frontend falls
# back to a plain tel: link instead of erroring.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Claude AI note-assistant (Integrations tab / Notes modal "Suggest follow-up", "Detect
# Date", and Marketing's AI Content Studio). Get a key from https://console.anthropic.com.
# Without it, those endpoints fall back to OpenAI below if that's set - or return
# configured=false with a clear "not configured" message if neither is.
ANTHROPIC_API_KEY=

# OpenAI - fallback for the same AI features above (AI Suggest Follow-up, Detect Date, AI
# Content Studio), used automatically whenever ANTHROPIC_API_KEY is unset OR the Claude call
# itself fails (e.g. Anthropic credit balance too low). Get a key from
# https://platform.openai.com/api-keys - billed separately from Anthropic, so this is a way
# to keep these features working even if only one of the two accounts is funded.
OPENAI_API_KEY=

# WhatsApp Business API (Meta Cloud API) - upgrades the WhatsApp button on Contacts/Leads
# to send a real message via https://developers.facebook.com/docs/whatsapp/cloud-api instead
# of just opening a wa.me link. Get these from https://developers.facebook.com (Meta for
# Developers > WhatsApp > API Setup). Without them, POST /api/whatsapp/send returns
# configured=false and the frontend falls back to opening wa.me.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# The WhatsApp Business Account (WABA) id, not the phone id above - only needed for
# GET /api/whatsapp/templates (listing approved message templates).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set when registering the webhook URL in the Meta App dashboard (Webhooks > WhatsApp Business
# Account > Verify and Save) - any string you choose, must match what you enter there.
# GET /api/webhooks/whatsapp verifies against this.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (App Dashboard > Settings > Basic) - used to verify the X-Hub-Signature-256
# header on every inbound webhook POST, so only genuine requests from Meta are processed.
# Optional but strongly recommended before going live; without it, POST /api/webhooks/whatsapp
# accepts any request without checking who sent it.
WHATSAPP_APP_SECRET=

# WhatsApp Flows (native in-chat forms - loan applications, KYC checklists, bookings).
# The RSA keypair below is generated once per Flow and required for the Flow's Endpoint URI
# to work at all - Meta encrypts every screen request with the public half, which you upload
# in WhatsApp Manager > Flows > your Flow > Endpoint > "Sign public key". Generate the pair
# with:
#   openssl genrsa -out flow_private.pem 2048
#   openssl rsa -in flow_private.pem -pubout -out flow_public.pem
# Give flow_public.pem's contents to Meta; keep flow_private.pem here, never commit it.
# Point at the file (simplest) or paste the PEM inline with real newlines escaped as \n.
WHATSAPP_FLOW_PRIVATE_KEY_PATH=
WHATSAPP_FLOW_PRIVATE_KEY=
# Only needed if you generated the key with a passphrase (openssl genrsa -aes256 ...).
WHATSAPP_FLOW_PRIVATE_KEY_PASSWORD=

# Email Service (SMTP) - upgrades the "Send Email" button on Contacts/Leads to send a real
# email instead of just opening a mailto: link. Any SMTP provider works (Gmail app password,
# SendGrid, Mailgun, your own mail server). Without these, POST /api/email/send returns
# configured=false and the frontend falls back to mailto:.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Mailchimp (Marketing tab "Sync Contacts to Mailchimp"). Get the API key from
# https://admin.mailchimp.com/account/api/ - it ends in a server prefix like "-us21", which
# is used automatically to build the API URL. MAILCHIMP_AUDIENCE_ID is the target audience
# ("List ID") to sync contacts into. Without these, the sync endpoint returns
# configured=false instead of erroring.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# LinkedIn (Marketing tab "Post to LinkedIn") - unlike everything else above, this is OAuth,
# not a static key. Create an app at https://developer.linkedin.com under your Company Page,
# request the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products,
# and set LINKEDIN_REDIRECT_URI in that app's settings to match exactly what's below (must be
# an https:// URL once deployed - LinkedIn does not accept plain http:// in production).
# The user clicks "Connect LinkedIn" in the app itself; no value here needs pasting by hand.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback
# Where LinkedIn's callback redirects the browser back to after connecting. Defaults to the
# local dev frontend if unset - update to your real domain once deployed.
FRONTEND_URL=http://localhost:3000

# Priti - AI Voice Caller (Integrations tab). Get these from https://vapi.ai once you have an
# account, an assistant created from priti_vapi_assistant.json, and a phone number attached
# (an Indian 140-series number via an Exotel/Ozonetel SIP trunk, NOT Twilio - see the Priti
# plan artifact for why). Without all three, POST /api/voice-agent/call returns
# configured=false. Do not fill these in until the compliance checklist in that plan is done -
# insurer + DSA written sign-off, DLT registration, DND scrubbing, call recording.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Optional - checked against Vapi's webhook signature once you've confirmed the exact header
# name against your real account. POST /api/voice-agent/webhook works without it, just
# unauthenticated.
VAPI_WEBHOOK_SECRET=
