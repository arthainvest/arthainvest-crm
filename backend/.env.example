# Copy this file to .env and fill in real values before running the app.
# Never commit the actual .env file - it's already gitignored.

# Set to "production" on a real deployment. When production, the app refuses to start
# if SECRET_KEY is left unset (see auth.py) instead of silently using an insecure default.
ENVIRONMENT=development

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production - the app will not start without it.
SECRET_KEY=your-secret-key-change-this

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Defaults to "*" (allow any origin) if unset - fine for local dev, must be restricted
# to real origin(s) in production.
CORS_ORIGINS=*

# Set to "false" to skip inserting the demo testuser/leads/deals/etc. on first run
# against a genuinely empty database. Has no effect once the database already has data -
# init_db() never re-seeds or wipes an existing database on later restarts either way.
SEED_DEMO_DATA=true

# Only used by database.py / main_postgresql.py (the separate, currently-incomplete
# Postgres implementation - the app you're running uses SQLite via database_sqlite.py
# and doesn't read these).
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=arthainvest_crm
DB_PORT=5432
