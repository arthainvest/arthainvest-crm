# Copy this file to .env and fill in real values before running/building the app.
# Never commit the actual .env file - it's already gitignored.
# CRA only picks up vars prefixed with REACT_APP_, and they're baked into the build at
# build time - changing .env requires a rebuild, not just a server restart.

# Base URL of the backend API. Defaults to http://localhost:8000 if unset (see
# src/services/api.js) - set this to your real backend's public URL before deploying.
REACT_APP_API_URL=http://localhost:8000

REACT_APP_APP_NAME=ArthaInvest CRM
