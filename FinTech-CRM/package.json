{
  "name": "arthainvest-fintech-crm",
  "version": "1.0.0",
  "description": "Production-grade Fintech CRM for ArthaInvest - Kylas-inspired design with advanced features",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec node server/index.js",
    "client:dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "db:migrate": "node server/migrations/migrate.js",
    "db:seed": "node server/migrations/seed.js",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx,.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.6.0",
    "zustand": "^4.4.0",
    "recharts": "^2.10.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.292.0",
    "clsx": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "framer-motion": "^10.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0"
  }
}
